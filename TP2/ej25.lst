   696                                  irq1Handler:
   697                                  ;se pulse la tecla ‘J’ (mayúscula o minúscula indistintamente), se
   698                                  ;ejecute cualquier operación no válida que genere una excepción. Cualquier otra
   699                                  ;tecla, continúa la lógica planteada en el Ejercicio 2.3 (actualiza el contador en
   700                                  ;pantalla).
   701                                  ;analizar si la tecla presionada es 'J' -- 0x24 es el scan code de la 'j'
   702 00000568 FA                        cli	;disable interrupts
   703 00000569 B020                      mov al, 0x20
   704 0000056B E620                      out 0x20, al
   705 0000056D E460                      in al, 0x60
   706 0000056F 3C24                      cmp al, 0x24 ;003C (00BD es breakcode) es F2 003D es F3
   707 00000571 7512                      jne no_jota ;si se pulso tecla distinta a jota.
   708                                    ;aca genero excepcion, por ej, divido por cero
   709 00000573 6631C0                    xor eax, eax
   710 00000576 66BA01000000              mov edx, 1
   711 0000057C 66B900000000              mov ecx, 0
   712 00000582 66F7F1                    div ecx     ;provoca excepcion 
