   667                                      bucle_pantalla_2: ; pinta toda la pantalla de azul
   668 0000052F B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   669 00000531 26678807                    mov [es:edi], al ;borro caracter 
