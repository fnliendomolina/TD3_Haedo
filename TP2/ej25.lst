   763                                  printScreenUp:
   764                                    ;Cuando entro a código de nivel 0 mediante la call gate, lo primero que tengo que hacer es cargar los selectores de nivel 0 en DS, ES, 
   765                                    ;pues yo venia de nivel 3
   766 000005C7 B80800                    mov ax, dataSel_Lvl0
   767 000005CA 8ED8                      mov ds, ax
   768 000005CC B81800                    mov ax, videoSel_Lvl0
