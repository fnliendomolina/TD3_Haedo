   569 0000047A B0FD                    mov al, 0xfd ; Mascara PIC Master (0x21)   0xfd   1111 1101 (IRQ9) estos 8 bits es el IMR, en 0 la INT que habilito
   570 0000047C E621                    out 0x21, al
