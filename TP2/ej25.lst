   542 0000044B 6631C0                  xor eax, eax	;clear bits eax
   543 0000044E 66B8[F3020000]          mov eax, idt
   544 00000454 66A3[0B00]              mov [idtr + 2], eax	;ubicacion de la idt en memoria	
   545                                  
   546                                  ; cargo en el registro gdtr (tabla global de desc)
   547 00000458 0F0116[0300]            lgdt [gdtr]
   548                                  
   549                                  ; cargo en el registro idtr load idt (tabla de INT)
   550 0000045D 0F011E[0900]            lidt [idtr]
