   770                                  
   771                                    ;Muevo contador de tiempo tarea 1 a ax
   772 000005D1 3EA1[6B00]                mov ax, [ds:tiempoTarea1] 
   773                                  
   774                                    ;Logica para separar en decenas y unidades de decimas de segundos el contador de tiempo de la tarea 1
   775 000005D5 31D2                      xor dx, dx    ; limpio dx antes de cada div pues en 16 bits hace DX:AX / BX
   776 000005D7 BB6400                    mov bx, 100
