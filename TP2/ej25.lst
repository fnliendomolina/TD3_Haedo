   496                                  ;comienzo del codigo
   497                                  inicio: 
   498                                  ;deshabilito interruciones
   499 0000040B FA                          cli
   500                                  
   501                                  ;Inicializacion PIC 1
   502 0000040C B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   503 0000040E E620                        out 0x20, al
   504 00000410 B020                        mov al, 0x20 ; icw2: INT base para el PIC N#1 tipo 20H (IRQ0 sera el tipo de interrupcion 20h)
   505 00000412 E621                        out 0x21, al ; el PIC1 comienza en 0x20
   506 00000414 B004                        mov al, 0x04 ; icw3: PIC N#1 Master tiene un slave conectado a IRQ2 (0000 0100b)
   507 00000416 E621                        out 0x21, al
   508 00000418 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   509 0000041A E621                        out 0x21, al
   510                                  
   511                                  ;Inicializacion PIC 2
   512 0000041C B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   513 0000041E E6A0                        out 0xa0, al
   514 00000420 B028                        mov al, 0x28 ; icw2: INT base para el PIC N#1 tipo 28h
   515 00000422 E6A1                        out 0xa1, al ; el PIC2 comienza en 0x28
   516 00000424 B002                        mov al, 0x02 ; icw3: PIC N#2 Slave, IRQ2 es la linea que envia al Master (010b)
   517 00000426 E6A1                        out 0xa1, al
   518 00000428 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   519 0000042A E6A1                        out 0xa1, al
