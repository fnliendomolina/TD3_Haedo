   521                                  ;-------- Reconfiguro Timer para que interrumpa cada 1ms ------------
   522                                      ; Para reprogramar el timer tick para que interrumpa cada 1 ms
   523                                      ; debo dividir los 1,193180Mhz por la cuenta a cargar en el 8253/4
   524                                      ; Por ejemplo: 1mseg1.19e6 / 04a6h (1190) = 1000 ints/s 
   525 0000042C B8A604                      mov ax,04a6h
   526 0000042F E640                        out 40h,al ; Parte Baja
   527 00000431 88E0                        mov al,ah
   528 00000433 E640                        out 40h,al ; Parte Alta
   529                                  
   530                                  ;cargo gdtr
   531 00000435 B87700                  mov ax, gdtSize - 1	;longitud de gdt - 1
   532 00000438 A3[0300]                mov [gdtr + 0], ax		
   533                                  
   534 0000043B 6631C0                  xor eax, eax
   535 0000043E B8[7B02]                mov ax, gdt
   536 00000441 66A3[0500]              mov [gdtr + 2], eax	;ubicacion de la gdt en memoria	
   537                                  
