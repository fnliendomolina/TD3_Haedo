   378                                  irq1Handler:
   379                                  ;se pulse la tecla ‘J’ (mayúscula o minúscula indistintamente), se
   380                                  ;ejecute cualquier operación no válida que genere una excepción. Cualquier otra
   381                                  ;tecla, continúa la lógica planteada en el Ejercicio 2.3 (actualiza el contador en
   382                                  ;pantalla).
   383                                  ;analizar si la tecla presionada es 'J' -- 0x24 es el scan code de la 'j'
   384 00000293 FA                        cli	;disable interrupts
   385 00000294 B020                      mov al, 0x20
   386 00000296 E620                      out 0x20, al
   387 00000298 E460                      in al, 0x60
   388 0000029A 3C24                      cmp al, 0x24
   389 0000029C 7512                      jne no_jota ;si se pulso tecla distinta a jota.
   390                                    ;aca genero excepcion, por ej, divido por cero
   391 0000029E 6631C0                    xor eax, eax
   392 000002A1 66BA01000000              mov edx, 1
   393 000002A7 66B900000000              mov ecx, 0
   394 000002AD 66F7F1                    div ecx     ;provoca excepcion 
   395                                  
   396                                  no_jota:
   397                                  ;incremento contador de teclas
   398 000002B0 6631C0                    xor eax, eax
   399 000002B3 A0[1300]                  mov al, [key_state]
   400 000002B6 3C00                      cmp al, 0	;zero set variable 1
   401 000002B8 7514                      jne set_key_state
