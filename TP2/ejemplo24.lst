   269                                  ;paso a modo protegido
   270 000001E0 0F20C0                  mov eax, cr0
   271 000001E3 0C01                    or al,1
   272 000001E5 0F22C0                  mov cr0, eax
   273 000001E8 EB00                    jmp short $+2
   274                                  
   275                                  ;cargo en cs el selector de codigo codeSel0
   276 000001EA EA[EF01]1800            jmp codeSel0:modo_protegido	;salto largo, guardo en CS el selector de codigo para modo protegido
   277                                  
   278                                  modo_protegido:
   279                                  ;load ss, ds, and es with data select (used for print screen)
   280 000001EF B80800                  mov ax, dataSel0
   281 000001F2 8ED0                    mov ss, ax	;como trabajo con INT debo config la PILA. SS:ESP (debo definir un area de pila)
   282 000001F4 8ED8                    mov ds, ax
   283                                  
   284                                  ;guardo los datos para la pila en la direccion fin+100h. El ESP va decrementado a medida que guardo en la PILA.
   285                                  ;si la pila ocupa mas de 100h va a comerse parte del codigo (ojo)
   286                                  
   287                                  ;apunto esp al final del codigo + 0x100 (100 bytes)... ahi empieza la PILA
   288 000001F6 66B8[D5030000]          mov eax, fin + 0x100
   289 000001FC 6689C4                  mov esp, eax
   290                                  
   291                                  ;enmascaro todas las interrupciones menos la irq1 (Teclado) enable -   int 9h solo dejo las que quiero usar
   292                                  ;                                            irq0 (timer tick) disable int 8h
   293                                  
   294 000001FF B0FD                    mov al, 0xfd            ; Mascara PIC Master (0x21)   0xfd   1111 1101 (IRQ9) estos 8 bits es el IMR, en 0 la INT que habilito
   295 00000201 E621                    out 0x21, al
   296                                  
   297 00000203 B0FF                    mov al, 0xff            ; Mascara PIC Slave (0xff)
   298 00000205 E6A1                    out 0xa1, al
