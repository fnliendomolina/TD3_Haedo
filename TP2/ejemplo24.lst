   247                                  ;cargo gdtr
   248 000001B3 B81F00                  mov ax, gdtSize - 1	;longitud de gdt - 1
   249 000001B6 A3[0300]                mov [gdtr + 0], ax		
   250                                  
   251 000001B9 6631C0                  xor eax, eax
   252 000001BC B8[6200]                mov ax, gdt
   253 000001BF 66A3[0500]              mov [gdtr + 2], eax	;ubicacion de la gdt en memoria	
   254                                  
   255                                  ;cargo idtr
   256 000001C3 B80F01                  mov ax, idtSize - 1	;longitud de idt - 1
   257 000001C6 A3[0900]                mov [idtr + 0], ax		
   258                                  
   259 000001C9 6631C0                  xor eax, eax	;clear bits eax
   260 000001CC 66B8[82000000]          mov eax, idt
   261 000001D2 66A3[0B00]              mov [idtr + 2], eax	;ubicacion de la idt en memoria	
   262                                  
   263                                  ; cargo en el registro gdtr (tabla global de desc)
   264 000001D6 0F0116[0300]            lgdt [gdtr]
   265                                  
   266                                  ; cargo en el registro idtr load idt (tabla de INT)
   267 000001DB 0F011E[0900]            lidt [idtr]
