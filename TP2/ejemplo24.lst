   213                                    ;PUERTA de interrupcion (int 0x21, irq1, teclado)
   214 0000018C [A102]                    dw irq1Handler	;2 bytes offset donde estara el handler a partir de la base del code segment
   215 0000018E 1800                      dw codeSel0	;low part
   216 00000190 00                        db 0		;bits from 32 to 39 set 0
   217 00000191 86                        db 0x86	;byte attr: P=1 DPL=00 S=0 (system) TIPO=0110 (Gate int. 16 bits) 
