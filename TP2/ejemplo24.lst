   380                                  irq1Handler:
   381                                  ;se pulse la tecla ‘J’ (mayúscula o minúscula indistintamente), se
   382                                  ;ejecute cualquier operación no válida que genere una excepción. Cualquier otra
   383                                  ;tecla, continúa la lógica planteada en el Ejercicio 2.3 (actualiza el contador en
   384                                  ;pantalla).
   385                                  ;analizar si la tecla presionada es 'J' -- 0x24 es el scan code de la 'j'
   386 000002A1 FA                        cli	;disable interrupts
   387 000002A2 B020                      mov al, 0x20
   388 000002A4 E620                      out 0x20, al
   389 000002A6 E460                      in al, 0x60
   390 000002A8 3C24                      cmp al, 0x24
   391 000002AA 7512                      jne no_jota ;si se pulso tecla distinta a jota.
   392                                    ;aca genero excepcion, por ej, divido por cero
   393 000002AC 6631C0                    xor eax, eax
   394 000002AF 66BA01000000              mov edx, 1
   395 000002B5 66B900000000              mov ecx, 0
   396 000002BB 66F7F1                    div ecx     ;provoca excepcion 
   397                                  
   398                                  no_jota:
