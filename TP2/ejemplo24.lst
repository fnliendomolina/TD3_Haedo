   340                                  excHandler:
   341                                  ;Handler que atiende la excepcion cuando se divide por cero por ej.
   342 0000024A FA                          cli
   343                                      ; Primero pinto toda la pantalla de azul: usare el selector de video, pero recordar que ya lo habia cargado de antes en es
   344 0000024B B9D007                      mov cx, 80*25 ;cargo cantidad de puntos en pantalla a pintar
   345 0000024E 66BF00000000                mov edi, 0x00 ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
   346 00000254 66BA00000000                mov edx, 0x00
   347                                      
   348                                      bucle_pantalla_2: ; pinta toda la pantalla de azul
   349 0000025A B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   350 0000025C 26678807                    mov [es:edi], al ;borro caracter 
   351 00000260 6647                        inc edi          ;incremento edi para pasar al atributo
   352 00000262 B011                        mov al, 0x11     ;cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
   353 00000264 26678807                    mov [es:edi], al 
   354 00000268 6647                        inc edi          ;incremento edi para pasar al otro caracter
   355                                      ;ciclo hasta terminar de recorrer el buffer de video
   356 0000026A E2EE                        loop bucle_pantalla_2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
   357                                      
   358 0000026C 6631FF                      xor edi, edi ; vuelvo a poner el offset en 0, para escribir en el primer caracter
   359 0000026F 6631C0                      xor eax, eax ; vuelvo a poner en 0 eax
   360                                      
   361                                      ;Ahora muestro mensaje de "error"
   362                                      printMessage:
   363 00000272 3E678A82[14000000]          mov al, BYTE [ds:msgException+edx] ; Leo un char del string
   364 0000027A 3C00                        cmp al, 0                    ; Si es NULL fin del string
   365 0000027C 7412                        je endMessage
   366 0000027E 6642                        inc edx                      ; Muevo el indice al char siguiente
   367 00000280 26678807                    mov [es:edi], al             ; Print char
   368 00000284 6647                        inc edi                      ; Inc indice (Attr char)
   369 00000286 B017                        mov al, 0x17                 ; Attr char en azul y background en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
   370 00000288 26678807                    mov [es:edi], al
   371 0000028C 6647                        inc edi                      ; Next char
   372 0000028E EBE2                        jmp printMessage; vuelvo a el inicio de la etiqueta loop
   373                                      endMessage:   
   374 00000290 EBFE                        jmp $
   375 00000292 FB                          sti
