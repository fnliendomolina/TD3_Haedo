    35                                  gdt:
    36                                    ;descriptor nulo
    37 00000062 <res 00000008>            resb 8
    37          ******************       warning: uninitialized space declared in .text section: zeroing [-w+other]
    38                                  
    39                                   ; descriptor de datos (base 0, size 64k, nivel 0)
    40                                  dataSel0 equ $-gdt ; selector descr segment data --> index = 1, TI = 0, RPL = 00
    41                                  
    42 0000006A FFFF                      dw 0xffff     ; limit low part = 65536 = 64k
    43 0000006C 0000                      dw 0x0000     ; first 2 bytes set = 0
    44 0000006E 00                        db 0x00       ; 3er byte base = 0
    45 0000006F 92                        db 10010010b  ; attr:P=1 DPL=00 S=1 TIPO=001 (E=0 data segment, ED=0, W=1 write) A=0 
    46 00000070 00                        db 0x00       ; attr high part = 0
    47 00000071 00                        db 0x00       ; 4to byte base = 0
    48                                  
    49                                  ; video descriptor (offset: 0xb8000, size 4k, nivel 0)
    50                                  videoSel0 equ $-gdt ; selector descr video segment data --> index = 3, TI = 0, RPL = 00
    51                                  
    52 00000072 0010                     dw 0x1000     ; limit low part = 4096 = 4k
    53 00000074 0080                     dw 0x8000     ; base = 0xb8000, first 2 bytes set 8000
    54 00000076 0B                       db 0x0b       ; 3 byte set b
    55 00000077 92                       db 10010010b  ; attr: P=1 DPL=00 S=1 TIPO=001 (E=0 data segment, ED=0, W=1 write) A=0
    56 00000078 00                       db 0x00       ; attr high part = 0
    57 00000079 00                       db 0x00       ; 4to byte base = 0
    58                                  
    59                                  ; code descriptor (base 0x0000, size 64k, nivel 0) for handler
    60                                  codeSel0 equ $-gdt ; selector descr segment code --> index = 2, TI = 0, RPL = 00
    61 0000007A FFFF                      dw 0xffff	; limit low part = 65536 = 64k
    62 0000007C 0000                      dw 0x0000	; first 2 bytes base = 0
    63 0000007E 00                        db 0x00	; 3er byte base = 0
    64 0000007F 9A                        db 10011010b	; Attr: P=1 DPL=00 S=1 TIPO=101 (E=1 code segment, C=0, R=1 read and execute) A=0
    65 00000080 00                        db 0x00	; attr high part = 0
    66 00000081 00                        db 0x00	; 4to byte base = 0
    67                                  
    68                                  ;tamaño de la gdt
    69                                  gdtSize equ $-gdt
