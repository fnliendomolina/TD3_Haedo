   303                                  ;Pantalla en modo inverso
   304 00000209 B81000                  mov ax, videoSel0
   305 0000020C 8EC0                    mov es, ax
   306 0000020E B9D007                  mov cx, 80*25	;set count pixels
   307 00000211 66BF00000000            mov edi, 0x00	;set index = 0 
   308                                  
   309                                  bucle_pantalla:
   310 00000217 B000                      mov al, 0x00	;clear character
   311 00000219 26678807                  mov [es:edi], al	;clear
   312 0000021D 6647                      inc edi	;change attr
   313 0000021F B077                      mov al, 0x77	;set attr char white and background white --> 0 111 | 0 111
   314 00000221 26678807                  mov [es:edi], al
   315 00000225 6647                      inc edi
   316                                    ;ciclo hasta terminar de recorrer el buffer de video
   317 00000227 E2EE                      loop bucle_pantalla	;cx-- and loop while cx>0
   318                                  	
   319 00000229 FB                      sti	;habilito interrupciones
