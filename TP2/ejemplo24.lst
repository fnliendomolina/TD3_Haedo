   302 00000207 B81000                  mov ax, videoSel0
   303 0000020A 8EC0                    mov es, ax
   304 0000020C B9D007                  mov cx, 80*25	;set count pixels
   305 0000020F 66BF00000000            mov edi, 0x00	;set index = 0 
   306                                  
   307                                  bucle_pantalla:
   308 00000215 B000                      mov al, 0x00	;clear character
   309 00000217 26678807                  mov [es:edi], al	;clear
   310 0000021B 6647                      inc edi	;change attr
   311 0000021D B077                      mov al, 0x77	;set attr char white and background white --> 0 111 | 0 111
   312 0000021F 26678807                  mov [es:edi], al
   313 00000223 6647                      inc edi
   314                                    ;ciclo hasta terminar de recorrer el buffer de video
   315 00000225 E2EE                      loop bucle_pantalla	;cx-- and loop while cx>0
