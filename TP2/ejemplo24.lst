   219                                  ;***********************************
   220                                  ;	Codigo
   221                                  ;***********************************
   222                                  ;comienzo del codigo
   223                                  inicio: 
   224                                  ;deshabilito interruciones
   225 00000192 FA                          cli
   226                                  
   227                                  ;Inicializacion PIC 1
   228 00000193 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   229 00000195 E620                        out 0x20, al
   230 00000197 B020                        mov al, 0x20 ; icw2: INT base para el PIC N#1 tipo 20H (IRQ0 sera el tipo de interrupcion 20h)
   231 00000199 E621                        out 0x21, al ; el PIC1 comienza en 0x20
   232 0000019B B004                        mov al, 0x04 ; icw3: PIC N#1 Master tiene un slave conectado a IRQ2 (0000 0100b)
   233 0000019D E621                        out 0x21, al
   234 0000019F B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   235 000001A1 E621                        out 0x21, al
   236                                  
   237                                  ;Inicializacion PIC 2
   238 000001A3 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   239 000001A5 E6A0                        out 0xa0, al
   240 000001A7 B028                        mov al, 0x28 ; icw2: INT base para el PIC N#1 tipo 28h
   241 000001A9 E6A1                        out 0xa1, al ; el PIC2 comienza en 0x28
   242 000001AB B002                        mov al, 0x02 ; icw3: PIC N#2 Slave, IRQ2 es la linea que envia al Master (010b)
   243 000001AD E6A1                        out 0xa1, al
   244 000001AF B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   245 000001B1 E6A1                        out 0xa1, al
