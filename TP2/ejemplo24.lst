   211                                    ;PUERTA de interrupcion (int 0x21, irq1, teclado)
   212 0000018A [9302]                    dw irq1Handler	;2 bytes offset donde estara el handler a partir de la base del code segment
   213 0000018C 1800                      dw codeSel0	;low part
   214 0000018E 00                        db 0		;bits from 32 to 39 set 0
   215 0000018F 86                        db 0x86	;byte attr: P=1 DPL=00 S=0 (system) TIPO=0110 (Gate int. 16 bits) 
