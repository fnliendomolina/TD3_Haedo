   328 0000023A 6647                    	inc edi		;attr char
   329 0000023C B070                    	mov al, 0x70		;black char 0111 0000
   330 0000023E 26678807                	mov [es:edi], al
   331 00000242 6647                    	inc edi ;next char
   332                                  
   333 00000244 3EA0[6300]                mov al, [ds:counter_unidades]
   334 00000248 0430                    	add al, 0x30		;convert number 1 digit to ASCII 
