   221                                  ;***********************************
   222                                  ;	Codigo
   223                                  ;***********************************
   224                                  ;comienzo del codigo
   225                                  inicio: 
   226                                  ;deshabilito interruciones
   227 00000194 FA                          cli
   228                                  
   229                                  ;Inicializacion PIC 1
   230 00000195 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   231 00000197 E620                        out 0x20, al
   232 00000199 B020                        mov al, 0x20 ; icw2: INT base para el PIC N#1 tipo 20H (IRQ0 sera el tipo de interrupcion 20h)
   233 0000019B E621                        out 0x21, al ; el PIC1 comienza en 0x20
   234 0000019D B004                        mov al, 0x04 ; icw3: PIC N#1 Master tiene un slave conectado a IRQ2 (0000 0100b)
   235 0000019F E621                        out 0x21, al
   236 000001A1 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   237 000001A3 E621                        out 0x21, al
   238                                  
   239                                  ;Inicializacion PIC 2
   240 000001A5 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   241 000001A7 E6A0                        out 0xa0, al
   242 000001A9 B028                        mov al, 0x28 ; icw2: INT base para el PIC N#1 tipo 28h
   243 000001AB E6A1                        out 0xa1, al ; el PIC2 comienza en 0x28
   244 000001AD B002                        mov al, 0x02 ; icw3: PIC N#2 Slave, IRQ2 es la linea que envia al Master (010b)
   245 000001AF E6A1                        out 0xa1, al
   246 000001B1 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   247 000001B3 E6A1                        out 0xa1, al
   248                                  
   249                                  ;cargo gdtr
   250 000001B5 B81F00                  mov ax, gdtSize - 1	;longitud de gdt - 1
   251 000001B8 A3[0300]                mov [gdtr + 0], ax		
   252                                  
   253 000001BB 6631C0                  xor eax, eax
   254 000001BE B8[6400]                mov ax, gdt
   255 000001C1 66A3[0500]              mov [gdtr + 2], eax	;ubicacion de la gdt en memoria	
   256                                  
   257                                  ;cargo idtr
   258 000001C5 B80F01                  mov ax, idtSize - 1	;longitud de idt - 1
   259 000001C8 A3[0900]                mov [idtr + 0], ax		
   260                                  
   261 000001CB 6631C0                  xor eax, eax	;clear bits eax
   262 000001CE 66B8[84000000]          mov eax, idt
   263 000001D4 66A3[0B00]              mov [idtr + 2], eax	;ubicacion de la idt en memoria	
   264                                  
   265                                  ; cargo en el registro gdtr (tabla global de desc)
   266 000001D8 0F0116[0300]            lgdt [gdtr]
   267                                  
   268                                  ; cargo en el registro idtr load idt (tabla de INT)
   269 000001DD 0F011E[0900]            lidt [idtr]
   270                                  
   271                                  ;paso a modo protegido
   272 000001E2 0F20C0                  mov eax, cr0
   273 000001E5 0C01                    or al,1
   274 000001E7 0F22C0                  mov cr0, eax
   275 000001EA EB00                    jmp short $+2
   276                                  
   277                                  ;cargo en cs el selector de codigo codeSel0
   278 000001EC EA[F101]1800            jmp codeSel0:modo_protegido	;salto largo, guardo en CS el selector de codigo para modo protegido
   279                                  
   280                                  modo_protegido:
   281                                  ;load ss, ds, and es with data select (used for print screen)
   282 000001F1 B80800                  mov ax, dataSel0
   283 000001F4 8ED0                    mov ss, ax	;como trabajo con INT debo config la PILA. SS:ESP (debo definir un area de pila)
   284 000001F6 8ED8                    mov ds, ax
   285                                  
   286                                  ;guardo los datos para la pila en la direccion fin+100h. El ESP va decrementado a medida que guardo en la PILA.
   287                                  ;si la pila ocupa mas de 100h va a comerse parte del codigo (ojo)
   288                                  
   289                                  ;apunto esp al final del codigo + 0x100 (100 bytes)... ahi empieza la PILA
   290 000001F8 66B8[F2030000]          mov eax, fin + 0x100
   291 000001FE 6689C4                  mov esp, eax
   292                                  
   293                                  ;enmascaro todas las interrupciones menos la irq1 (Teclado) enable -   int 9h solo dejo las que quiero usar
   294                                  ;                                            irq0 (timer tick) disable int 8h
   295                                  
   296 00000201 B0FD                    mov al, 0xfd            ; Mascara PIC Master (0x21)   0xfd   1111 1101 (IRQ9) estos 8 bits es el IMR, en 0 la INT que habilito
   297 00000203 E621                    out 0x21, al
   298                                  
   299 00000205 B0FF                    mov al, 0xff            ; Mascara PIC Slave (0xff)
   300 00000207 E6A1                    out 0xa1, al
   301                                  
