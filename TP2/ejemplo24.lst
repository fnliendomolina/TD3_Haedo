    37                                  gdt:
    38                                    ;descriptor nulo
    39 00000064 <res 00000008>            resb 8
    39          ******************       warning: uninitialized space declared in .text section: zeroing [-w+other]
    40                                  
    41                                   ; descriptor de datos (base 0, size 64k, nivel 0)
    42                                  dataSel0 equ $-gdt ; selector descr segment data --> index = 1, TI = 0, RPL = 00
    43                                  
    44 0000006C FFFF                      dw 0xffff     ; limit low part = 65536 = 64k
    45 0000006E 0000                      dw 0x0000     ; first 2 bytes set = 0
    46 00000070 00                        db 0x00       ; 3er byte base = 0
    47 00000071 92                        db 10010010b  ; attr:P=1 DPL=00 S=1 TIPO=001 (E=0 data segment, ED=0, W=1 write) A=0 
    48 00000072 00                        db 0x00       ; attr high part = 0
    49 00000073 00                        db 0x00       ; 4to byte base = 0
    50                                  
    51                                  ; video descriptor (offset: 0xb8000, size 4k, nivel 0)
    52                                  videoSel0 equ $-gdt ; selector descr video segment data --> index = 3, TI = 0, RPL = 00
    53                                  
    54 00000074 0010                     dw 0x1000     ; limit low part = 4096 = 4k
    55 00000076 0080                     dw 0x8000     ; base = 0xb8000, first 2 bytes set 8000
    56 00000078 0B                       db 0x0b       ; 3 byte set b
    57 00000079 92                       db 10010010b  ; attr: P=1 DPL=00 S=1 TIPO=001 (E=0 data segment, ED=0, W=1 write) A=0
    58 0000007A 00                       db 0x00       ; attr high part = 0
    59 0000007B 00                       db 0x00       ; 4to byte base = 0
    60                                  
    61                                  ; code descriptor (base 0x0000, size 64k, nivel 0) for handler
    62                                  codeSel0 equ $-gdt ; selector descr segment code --> index = 2, TI = 0, RPL = 00
    63 0000007C FFFF                      dw 0xffff	; limit low part = 65536 = 64k
    64 0000007E 0000                      dw 0x0000	; first 2 bytes base = 0
    65 00000080 00                        db 0x00	; 3er byte base = 0
    66 00000081 9A                        db 10011010b	; Attr: P=1 DPL=00 S=1 TIPO=101 (E=1 code segment, C=0, R=1 read and execute) A=0
    67 00000082 00                        db 0x00	; attr high part = 0
    68 00000083 00                        db 0x00	; 4to byte base = 0
    69                                  
    70                                  ;tamaño de la gdt
    71                                  gdtSize equ $-gdt
