   342                                  excHandler:
   343                                  ;Handler que atiende la excepcion cuando se divide por cero por ej.
   344 00000258 FA                          cli
   345                                      ; Primero pinto toda la pantalla de azul: usare el selector de video, pero recordar que ya lo habia cargado de antes en es
   346 00000259 B9D007                      mov cx, 80*25 ;cargo cantidad de puntos en pantalla a pintar
   347 0000025C 66BF00000000                mov edi, 0x00 ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
   348 00000262 66BA00000000                mov edx, 0x00
   349                                      
   350                                      bucle_pantalla_2: ; pinta toda la pantalla de azul
   351 00000268 B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   352 0000026A 26678807                    mov [es:edi], al ;borro caracter 
   353 0000026E 6647                        inc edi          ;incremento edi para pasar al atributo
   354 00000270 B011                        mov al, 0x11     ;cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
   355 00000272 26678807                    mov [es:edi], al 
   356 00000276 6647                        inc edi          ;incremento edi para pasar al otro caracter
   357                                      ;ciclo hasta terminar de recorrer el buffer de video
   358 00000278 E2EE                        loop bucle_pantalla_2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
   359                                      
   360 0000027A 6631FF                      xor edi, edi ; vuelvo a poner el offset en 0, para escribir en el primer caracter
   361 0000027D 6631C0                      xor eax, eax ; vuelvo a poner en 0 eax
   362                                      
   363                                      ;Ahora muestro mensaje de error
   364                                      printMessage:
   365 00000280 3E678A82[14000000]          mov al, BYTE [ds:msgException+edx] ; Leo un char del string
   366 00000288 3C00                        cmp al, 0                    ; Si es NULL fin del string
   367 0000028A 7412                        je endMessage
   368 0000028C 6642                        inc edx                      ; Muevo el indice al char siguiente
   369 0000028E 26678807                    mov [es:edi], al             ; Print char
   370 00000292 6647                        inc edi                      ; Inc indice (Attr char)
   371 00000294 B017                        mov al, 0x17                 ; Attr char en azul y background en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
   372 00000296 26678807                    mov [es:edi], al
   373 0000029A 6647                        inc edi                      ; Next char
   374 0000029C EBE2                        jmp printMessage; vuelvo a el inicio de la etiqueta loop
   375                                      endMessage:   
   376 0000029E EBFE                        jmp $
   377 000002A0 FB                          sti
