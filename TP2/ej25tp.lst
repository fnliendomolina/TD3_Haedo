  1112                                  excHandler: ; handler general de la excepcion --> aca pinto toda la pantalla de azul por ejemplo, muestro un mensaje de error y numero de excepcion
  1113 00000867 FA                          cli
  1114                                  
  1115 00000868 6658                        pop eax         ; saco número excepción (vector) de la pila
  1116 0000086A 88C3                        mov bl, al      ; guardo en bl
  1117                                      
  1118                                      ; Primero pinto toda la pantalla de azul: usare el selector de video, pero recordar que ya lo habia cargado de antes en es
  1119 0000086C B9D007                      mov cx, 80*25 ;cargo cantidad de puntos en pantalla a pintar
  1120 0000086F 66BF00000000                mov edi, 0x00 ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
  1121 00000875 66BA00000000                mov edx, 0x00
  1122                                      
  1123                                      bucle_pantalla_2: ; pinta toda la pantalla de azul
  1124 0000087B B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
  1125 0000087D 26678807                    mov [es:edi], al ;borro caracter 
  1126 00000881 6647                        inc edi          ;incremento edi para pasar al atributo
  1127 00000883 B011                        mov al, 0x11     ;cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
  1128 00000885 26678807                    mov [es:edi], al 
  1129 00000889 6647                        inc edi          ;incremento edi para pasar al otro caracter
  1130                                      ;ciclo hasta terminar de recorrer el buffer de video
  1131 0000088B E2EE                        loop bucle_pantalla_2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
  1132                                      
  1133 0000088D 6631FF                      xor edi, edi ; vuelvo a poner el offset en 0, para escribir en el primer caracter
  1134 00000890 6631C0                      xor eax, eax ; vuelvo a poner en 0 eax
  1135                                      
  1136                                      ;Ahora muestro mensaje de "error"
  1137                                      printLoop:
  1138 00000893 3E678A82[22000000]          mov al, BYTE [ds:msgException+edx] ; Lee un caracter del string
  1139 0000089B 3C00                        cmp al, 0                    ; Si es 0 (Null) termina (End Of String)
  1140 0000089D 7412                        je finMensaje
  1141 0000089F 6642                        inc edx                      ; Incremento puntero string
  1142 000008A1 26678807                    mov [es:edi], al             ; Imprimo el caracter que esta almacenado en al
  1143 000008A5 6647                        inc edi                      ; Incremento el puntero (Color (atributo) del caracter)
  1144 000008A7 B017                        mov al, 0x17                 ; Cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
  1145 000008A9 26678807                    mov [es:edi], al
  1146 000008AD 6647                        inc edi                      ; Incremento el puntero (Siguiente caracter)
  1147 000008AF EBE2                        jmp printLoop; vuelvo a el inicio de la etiqueta loop
  1148                                      finMensaje: ;Imprimo numero de excepcion
  1149 000008B1 80C330                      add bl, '0'     ; convierto a ASCII
  1150 000008B4 2667881F                    mov [es:edi], bl
  1151 000008B8 6647                        inc edi
  1152 000008BA B017                        mov al, 0x17
  1153 000008BC 26678807                    mov [es:edi], al
  1154 000008C0 6647                        inc edi
  1155 000008C2 EBFE                        jmp $
  1156 000008C4 FB                          sti
  1157                                  fin:            
