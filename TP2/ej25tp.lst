   755 000005EE 3EA0[7400]                mov al, [ds:contadorDecenaT2]
   756 000005F2 0430                      add al, 0x30        ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   757 000005F4 BAF803                    mov dx, 0x3f8
   758 000005F7 EE                        out dx, al
   759                                    wait4:
   760 000005F8 BAFD03                    mov dx, 0x3FD  
