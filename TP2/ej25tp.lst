   890 000006D6 6681C7900B0000            add edi,80*37          ;llevo el puntero a la mitad inferior de la pantalla
   891                                    ;Imprimo decena
   892 000006DD 3EA0[7400]                mov al, [ds:contadorDecenaT2]
   893 000006E1 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   894 000006E3 26678807                  mov [es:edi], al ;imprimo decena en el caracter de la mitad de la mitad inferior de la pantalla (40*25)
   895 000006E7 6647                      inc edi                ;paso al byte de atributos 
   896 000006E9 B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   897 000006EB 26678807                  mov [es:edi], al
   898 000006EF 6647                      inc edi                ;paso a caracter de unidad
   899                                    ;Imprimo unidad
   900 000006F1 3EA0[7300]                mov al, [ds:contadorUnidadT2]
   901 000006F5 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   902 000006F7 26678807                  mov [es:edi], al       ;imprimo unidad
   903 000006FB 6647                      inc edi                ;paso al byte de atributos 
   904 000006FD B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   905 000006FF 26678807                  mov [es:edi], al
   906 00000703 6647                      inc edi
   907 00000705 6647                      inc edi 
   908 00000707 6647                      inc edi
   909                                    ;Imprimo ticksMax por tarea2
   910 00000709 3EA0[1E00]                mov al, [ds:ticksMaxTarea2]
   911 0000070D 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   912 0000070F 26678807                  mov [es:edi], al       ;imprimo 
   913 00000713 6647                      inc edi                ;paso al byte de atributos 
