   930                                  irq1Handler: ;Entra cada vez que se pulsa una tecla
   931 00000734 FA                          cli ;deshabilito interrupciones
   932                                      ;bajo flag de interrupcion --   EOI End of Interrupt. mandatorio.
   933 00000735 B020                        mov al, 0x20   ; 0x20, comando para bajar flag de interrupcion
   934 00000737 E620                        out 0x20, al   ; 0x20 aca es la direccion del puerto de E/S del PIC Master
   935                                      
   936                                      ; aca leo el teclado para ver si se presiono la j, que es la que hara algo que haga saltar una excepcion
   937 00000739 E460                        in al, 0x60               ; IMPORTANTE! aunque no lo use, leer el scan code porque sino se llena el buffer del teclado!!
   938 0000073B 3C10                        cmp al, Tecla_J_MakeCode  ; Si se pulso la tecla J no salta 
   939 0000073D 7512                        jne no_es_la_jota         ; Si no se pulso la j, al sera distinto a 0x24 por lo tanto salta a no_es_la_jota y sigue
   940                                  
   941                                      ;si se pulso la jota no salta, hago algo que genere una excepcion, como por ejemplo dividir por 0
   942                                      ;Cuando divido por un registro de 32 bits (EXC), el par de registros EAX:EDX (número de 64 bits) se divide por este registro (EXC). Por lo tanto, debo poner a  cero el registro EAX y colocar el dividendo en EDX
   943 0000073F 6631C0                      xor eax, eax ; pongo en 0 eax
   944 00000742 66BA01000000                mov edx, 1   ; pongo el dividendo (cualquiera) en edx, en este caso 1
   945 00000748 66B900000000                mov ecx, 0   ; pongo el divisor 0, en edx
   946 0000074E 66F7F1                      div ecx      ; hace eax:edx dividido exc, osea algo dividido 0, debe generar la excepcion de dividir por 0
   947                                  
   948                                      no_es_la_jota:
   949 00000751 6631DB                      xor ebx, ebx ; limpio registro ebx
   950                                      ;si estado_tecla es 1 es porque ya pulse, por lo tanto cuando vuelva a entrar aca es porque solte y no aumento contador
   951 00000754 3E8A1E[0F00]                mov bl, [ds:estado_tecla]
   952 00000759 80FB00                      cmp bl, 0
   953 0000075C 0F859000                    jne resetear_estado_tecla ;si estado_tecla es 0, no es igual a 1, por lo tanto sigue
   954                                                               ;si estado_tecla es 1, es porque ya solte, por lo tanto salta y resetea estado tecla
   955                                                               
   956                                      ;pone en 1 estado_tecla y analiza si se presiona F2, F3 o F10
   957 00000760 B301                        mov bl, 1
   958 00000762 881E[0F00]                  mov [estado_tecla], bl
   959                                      ;in al, 0x60                ; vuelvo a leer teclado
   960 00000766 3C11                        cmp al, Tecla_A_MakeCode  ; Si se pulso la tecla A 
   961 00000768 7426                        je pulseA       
   962 0000076A 3C19                        cmp al, Tecla_F_MakeCode  ; Si se pulso la tecla F
   963 0000076C 7452                        je pulseF  
   964 0000076E 3C01                        cmp al, Tecla_ESC_MakeCode ; Si se pulso la tecla ESC
   965 00000770 0F85A900                    jne fin_handler   
   966                                  
   967                                      ;Logica si pulse ESC --> Pinto pantalla de blanco y hago HLT
   968                                      ;Primero pinto toda la pantalla de blanco (video inverso):
   969 00000774 B9D007                      mov cx, 80*25     ;cargo cantidad de puntos en pantalla a pintar
   970 00000777 66BF00000000                mov edi, 0x00     ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
   971                                      bucle_pantalla2: ; pinta toda la pantalla de blanco
   972 0000077D B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   973 0000077F 26678807                    mov [es:edi], al ;borro caracter 
   974 00000783 6647                        inc edi          ;incremento edi para pasar al atributo
   975 00000785 B077                        mov al, 0x77     ;cargo valor del atributo para poner cada caracter en blanco y fondo en blanco --> 0 111 | 0 111
   976 00000787 26678807                    mov [es:edi], al 
   977 0000078B 6647                        inc edi          ;incremento edi para pasar al otro caracter
   978                                      ;ciclo hasta terminar de recorrer el buffer de video
   979 0000078D E2EE                        loop bucle_pantalla2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
   980 0000078F F4                          hlt 
   981                                      ;jmp fin_handler
   982                                  
   983                                      pulseA: ;logica si pulse A --> aumento 10% prioridad de tarea A y disminuyo 10% prioridad de tarea B
   984                                      ;si ticksMaxTarea2 = 0 no sigo decrementandolo
   985 00000790 3EC606[1100]00              mov BYTE[ds:contadorTicksTarea1], 0 ; Reseteo contadorTicksTarea1
   986 00000796 3EC606[1200]00              mov BYTE[ds:contadorTicksTarea2], 0 ; Reseteo contadorTicksTarea2
   987 0000079C 3EA0[1E00]                  mov al,[ds:ticksMaxTarea2]
   988 000007A0 3C00                        cmp al,0
   989 000007A2 7453                        je noEjecutarTarea1o2
   990                                      ;si ticksMaxTarea2 todavia no es 0, aumento en 1 ticksMaxTarea1 y disminuyo en 1 ticksMaxTarea2
   991 000007A4 3EC606[1000]00              mov BYTE[ds:flagNoEjecutar], 0 ; Reseteo flagNoEjecutar
   992 000007AA 3EA0[1D00]                  mov al,[ds:ticksMaxTarea1]
   993 000007AE FEC0                        inc al
   994 000007B0 3EA2[1D00]                  mov [ds:ticksMaxTarea1],al
   995 000007B4 3EA0[1E00]                  mov al,[ds:ticksMaxTarea2]
   996 000007B8 FEC8                        dec al
   997 000007BA 3EA2[1E00]                  mov [ds:ticksMaxTarea2],al
   998 000007BE EB5D                        jmp fin_handler
   999                                  
  1000                                      pulseF: ;logica si pulse F --> aumento 10% prioridad de tarea B y disminuyo 10% prioridad de tarea A
  1001                                      ;si ticksMaxTarea1 = 0 no sigo decrementandolo
  1002 000007C0 3EC606[1100]00              mov BYTE[ds:contadorTicksTarea1], 0 ; Reseteo contadorTicksTarea1
  1003 000007C6 3EC606[1200]00              mov BYTE[ds:contadorTicksTarea2], 0 ; Reseteo contadorTicksTarea2
  1004 000007CC 3EA0[1D00]                  mov al,[ds:ticksMaxTarea1]
  1005 000007D0 3C00                        cmp al,0
  1006 000007D2 7423                        je noEjecutarTarea1o2
  1007                                      ;si ticksMaxTarea1 todavia no es 0, aumento en 1 ticksMaxTarea2 y disminuyo en 1 ticksMaxTarea1
  1008 000007D4 3EC606[1000]00              mov BYTE[ds:flagNoEjecutar], 0 ; Reseteo flagNoEjecutar
  1009 000007DA 3EA0[1E00]                  mov al,[ds:ticksMaxTarea2]
  1010 000007DE FEC0                        inc al
  1011 000007E0 3EA2[1E00]                  mov [ds:ticksMaxTarea2],al
  1012 000007E4 3EA0[1D00]                  mov al,[ds:ticksMaxTarea1]
  1013 000007E8 FEC8                        dec al
  1014 000007EA 3EA2[1D00]                  mov [ds:ticksMaxTarea1],al    
  1015 000007EE EB2D                        jmp fin_handler
  1016                                  
  1017                                      resetear_estado_tecla:     ; reseteo estado tecla
  1018 000007F0 B300                        mov bl, 0
  1019 000007F2 3E881E[0F00]                mov [ds:estado_tecla], bl
  1020                                  
  1021                                      noEjecutarTarea1o2:
  1022 000007F7 B001                        mov al, 1
  1023 000007F9 3EA2[1000]                  mov [ds:flagNoEjecutar],al
  1024                                      ; si tarea 1 o 2 ya no deben ejecutarse, me aseguro de que estadoConmutacion apunte a la que sí
  1025 000007FD 3E803E[1D00]00              cmp BYTE[ds:ticksMaxTarea1], 0
  1026 00000803 7412                        je setTarea2
  1027 00000805 3E803E[1E00]00              cmp BYTE[ds:ticksMaxTarea2], 0
  1028 0000080B 7402                        je setTarea1
  1029 0000080D EB0E                        jmp fin_handler
  1030                                      setTarea1:
  1031 0000080F 3EC606[2100]00              mov BYTE[ds:estadoConmutacion], 0
  1032 00000815 EB06                        jmp fin_handler
  1033                                      setTarea2:
  1034 00000817 3EC606[2100]01              mov BYTE[ds:estadoConmutacion], 1
  1035                                  
  1036                                      fin_handler:               ; Si no se pulso ninguna de las teclas indicadas salgo de la interrupcion sin hacer nada           
  1037 0000081D FB                          sti
  1038 0000081E CF                          iret                       ; fin de la interrupcion. interrupt return
