   566 00000477 66B8[C5080000]              mov eax, pilaTareaInicial_Niv0            ; Pila de la tarea inicial
   567 0000047D 6689C4                      mov esp, eax
   568                                  
   569                                      ;enmascaro todas las interrupciones menos la irq1 (Teclado)int 21h y irq0 (timer tick) disable int 20h (Luego del remapeado quedo asi)                                           
   570 00000480 B0FC                        mov al, 0xfc   ; Mascara PIC Master   0xfc   1111 1100 --> osea la IRQ1 es el 2do bit, la IRQ0 el primer bit, poniendo en 0 la habilito
   571 00000482 E621                        out 0x21, al   ; 0x21 es la direccion del registro de enmascaramiento del PIC Master
   572 00000484 B0FF                        mov al, 0xff   ; Mascara PIC Slave, ponemos todo en 1, osea deshabilito todas sus interrupciones pues no las uso
   573 00000486 E6A1                        out 0xa1, al   ; 0xA1 es la direccion del registro de enmascaramiento del PIC Slave
   574                                  
