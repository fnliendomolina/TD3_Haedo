   538 00000445 6631C0                      xor eax, eax
   539 00000448 66B8[F5020000]              mov eax, idt
   540 0000044E 66A3[0B00]                  mov [idtr + 2], eax	;ubicacion de la idt en memoria	
   541                                  
   542                                      ;cargo en el registro gdtr
   543 00000452 0F0116[0300]                lgdt [gdtr]
   544                                  
   545                                      ;cargo en el registro idtr      load idt
   546 00000457 0F011E[0900]                lidt [idtr]
   547                                  
