   515                                  
   516                                  ;-------- Reconfiguro Timer para que interrumpa cada 1ms ------------
   517                                      ; Para reprogramar el timer tick para que interrumpa cada 1 ms
   518                                      ; debo dividir los 1,193180Mhz por la cuenta a cargar en el 8253/4
   519                                      ; Por ejemplo: 1mseg1.19e6 / 04a6h (1190) = 1000 ints/s 
   520 00000426 B8A604                      mov ax,04a6h
   521 00000429 E640                        out 40h,al ; Parte Baja
   522 0000042B 88E0                        mov al,ah
   523 0000042D E640                        out 40h,al ; Parte Alta
   524                                  ;--------------------------------------------------------------------
   525                                  
   526                                      ;cargo gdtr
   527 0000042F B87700                      mov ax, gdtSize - 1	;cargo limite a la gdtr: longitud de gdt - 1
   528 00000432 A3[0300]                    mov [gdtr + 0], ax	;a partir de la primer posicion de los 6 bytes de gdtr, osea ocupo 2 bytes, que es el tamaño del limite, por eso uso ax
   529                                  
