   860                                  printPantallaInferior:
   861                                    ;Cuando entro a código de nivel 0 mediante la call gate, lo primero que tengo que hacer es cargar los selectores de nivel 0 en DS, ES, 
   862                                    ;pues yo venia de nivel 3 
   863 000006A7 B80800                    mov ax, dataSel_Niv0
   864 000006AA 8ED8                      mov ds, ax
