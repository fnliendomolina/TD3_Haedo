   580 0000048E B9D007                      mov cx, 80*25     ;cargo cantidad de puntos en pantalla a pintar
   581 00000491 66BF00000000                mov edi, 0x00     ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
   582                                      bucle_pantalla: ; pinta toda la pantalla de blanco
   583 00000497 B000                        mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   584 00000499 26678807                    mov [es:edi], al ;borro caracter 
   585 0000049D 6647                        inc edi          ;incremento edi para pasar al atributo
   586 0000049F B077                        mov al, 0x77     ;cargo valor del atributo para poner cada caracter en blanco y fondo en blanco --> 0 111 | 0 111
   587 000004A1 26678807                    mov [es:edi], al 
   588 000004A5 6647                        inc edi          ;incremento edi para pasar al otro caracter
   589                                      ;ciclo hasta terminar de recorrer el buffer de video
   590 000004A7 E2EE                        loop bucle_pantalla ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
