   494                                  ;-------- Remapeo de las interrupciones de los PICs -----------------------------------------------------------
   495                                      ;Inicializacion PIC 1
   496 00000406 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   497 00000408 E620                        out 0x20, al
   498 0000040A B020                        mov al, 0x20 ; icw2: INT base para el PIC N#1 tipo 20H (osea ahora IRQ0 sera el tipo de interrupcion 20h)
   499 0000040C E621                        out 0x21, al ; el PIC1 comienza en 0x20
   500 0000040E B004                        mov al, 0x04 ; icw3: PIC N#1 Master tiene un slave conectado a IRQ2 (0000 0100b)
   501 00000410 E621                        out 0x21, al
   502 00000412 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   503 00000414 E621                        out 0x21, al
   504                                  
   505                                      ;Inicializacion PIC 2
   506 00000416 B011                        mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   507 00000418 E6A0                        out 0xa0, al
   508 0000041A B028                        mov al, 0x28 ; icw2: INT base para el PIC N#1 tipo 28h
   509 0000041C E6A1                        out 0xa1, al ; el PIC2 comienza en 0x28
   510 0000041E B002                        mov al, 0x02 ; icw3: PIC N#2 Slave, IRQ2 es la linea que envia al Master (010b)
   511 00000420 E6A1                        out 0xa1, al
   512 00000422 B001                        mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   513 00000424 E6A1                        out 0xa1, al
