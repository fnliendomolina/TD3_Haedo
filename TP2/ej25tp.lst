   227 00000297 0080                      dw 0x8000     ; base = 0xb8000, en los primeros 2 bytes pongo 8000
   228 00000299 0B                        db 0x0b       ; en el 3er byte pongo b
   229 0000029A 92                        db 10010010b  ; atributos: P=1 DPL=00 S=1 TIṔO=001 (E=0 por lo tanto es segmento de datos, ED=0, W=1 por lo tanto puedo escribir) A=0
