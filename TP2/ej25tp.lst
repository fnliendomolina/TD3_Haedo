   790                                  printPantallaSuperior:
   791                                    ;Cuando entro a código de nivel 0 mediante la call gate, lo primero que tengo que hacer es cargar los selectores de nivel 0 en DS, ES, 
   792                                    ;pues yo venia de nivel 3
   793 0000061A B80800                    mov ax, dataSel_Niv0
   794 0000061D 8ED8                      mov ds, ax
   795 0000061F B81800                    mov ax, videoSel_Niv0
   796 00000622 8EC0                      mov es, ax
   797                                  
   798                                    ;Muevo contador de tiempo tarea 1 a ax
   799 00000624 3EA1[1700]                mov ax, [ds:tiempoTarea1] 
   800                                  
   801                                    ;Logica para separar en decenas y unidades de decimas de segundos el contador de tiempo de la tarea 1
   802 00000628 31D2                      xor dx, dx    ; limpio dx antes de cada div pues en 16 bits hace DX:AX / BX
   803 0000062A BB6400                    mov bx, 100
   804 0000062D F7F3                      div bx        ; AX = tiempo / 100 → resultado en AX
   805                                                  ; ahora AX tiene el número que queremos mostrar
   806                                                  ; vamos a separar ese número en decenas y unidades
   807 0000062F 89C1                      mov cx, ax    ; guardo el resultado del cociente para no perderlo
   808                                    ; Separar en decena y unidad
   809 00000631 89C8                      mov ax, cx    ; recupero el valor
   810 00000633 31D2                      xor dx, dx
   811 00000635 BB0A00                    mov bx, 10
   812 00000638 F7F3                      div bx        ; DX:AX / 10
   813                                                  ; Ax = cociente (decena), DX = resto (unidad)
   814 0000063A 3EA2[7200]                mov [ds:contadorDecenaT1], al
   815 0000063E 3E8816[7100]              mov [ds:contadorUnidadT1], dl
   816                                  
   817                                    ;Logica para imprimir el tiempo en la mitad superior de la pantalla
   818 00000643 6631C0                    xor eax, eax
   819 00000646 6631FF                    xor edi, edi           ;reseteo edi para que vaya superponiendo el contador a imprimir
   820 00000649 6681C710040000            add edi, 80*13         ;llevo el puntero a la mitad superior de la pantalla
   821                                    ;Imprimo decena
   822 00000650 3EA0[7200]                mov al, [ds:contadorDecenaT1]
   823 00000654 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   824 00000656 26678807                  mov [es:edi], al       ;imprimo decena en el caracter de la mitad de la mitad superior de la pantalla 
   825 0000065A 6647                      inc edi                ;paso al byte de atributos 
   826 0000065C B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   827 0000065E 26678807                  mov [es:edi], al
   828 00000662 6647                      inc edi                ;paso a caracter de unidad
   829                                    ;Imprimo unidad
   830 00000664 3EA0[7100]                mov al, [ds:contadorUnidadT1]
   831 00000668 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   832 0000066A 26678807                  mov [es:edi], al       ;imprimo unidad
   833 0000066E 6647                      inc edi                ;paso al byte de atributos 
   834 00000670 B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   835 00000672 26678807                  mov [es:edi], al
   836 00000676 6647                      inc edi
   837 00000678 6647                      inc edi 
   838 0000067A 6647                      inc edi
   839                                    ;Imprimo ticksMax por tarea1
   840 0000067C 3EA0[1D00]                mov al, [ds:ticksMaxTarea1]
   841 00000680 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   842 00000682 26678807                  mov [es:edi], al       ;imprimo 
   843 00000686 6647                      inc edi                ;paso al byte de atributos 
   844 00000688 B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   845 0000068A 26678807                  mov [es:edi], al
   846 0000068E 6647                      inc edi
   847 00000690 6647                      inc edi 
   848 00000692 6647                      inc edi
   849                                    ;Imprimo contadorTicksTarea1 
   850 00000694 3EA0[1100]                mov al, [ds:contadorTicksTarea1]
   851 00000698 0430                      add al, 0x30           ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   852 0000069A 26678807                  mov [es:edi], al       ;imprimo 
   853 0000069E 6647                      inc edi                ;paso al byte de atributos 
   854 000006A0 B070                      mov al, 0x70           ;para que el caracter a mostrar se vea de color negro
   855 000006A2 26678807                  mov [es:edi], al  
   856 000006A6 CB                        retf                   ;retorno de la callgate
