   869 000006B1 3EA1[1900]                mov ax, [ds:tiempoTarea2] 
   870                                  
   871                                    ;Logica para separar en decenas y unidades de decimas de segundos el contador de tiempo de la tarea 1
   872 000006B5 31D2                      xor dx, dx    ; limpio dx antes de cada div pues en 16 bits hace DX:AX / BX
   873 000006B7 BB6400                    mov bx, 100
   874 000006BA F7F3                      div bx        ; AX = tiempo / 100 → resultado en AX
   875                                                  ; ahora AX tiene el número que queremos mostrar (por ejemplo, 37)
   876                                                  ; vamos a separar ese número en decenas y unidades
   877 000006BC 89C1                      mov cx, ax    ; guardo el resultado del cociente para no perderlo
   878                                    ; Separar en decena y unidad
   879 000006BE 89C8                      mov ax, cx    ; recupero el valor
   880 000006C0 31D2                      xor dx, dx
   881 000006C2 BB0A00                    mov bx, 10
   882 000006C5 F7F3                      div bx        ; AX / 10
   883                                                  ; Ax = cociente (decena), DX = resto (unidad)
   884 000006C7 3EA2[7400]                mov [ds:contadorDecenaT2], al
   885 000006CB 3E8816[7300]              mov [ds:contadorUnidadT2], dl
