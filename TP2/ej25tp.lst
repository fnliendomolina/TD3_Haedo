   206                                  ; descriptor de datos de nivel 0 (Base: 0, size 64k, nivel 0)
   207                                  dataSel_Niv0 equ $-gdt ; selector del descriptor de segmento de datos de nivel 0 --> index = 1, TI = 0, RPL = 00 (Niv 0)
   208 00000285 FFFF                      dw 0xffff     ; limite parte baja = 65536 = 64k
   209 00000287 0000                      dw 0x0000     ; primeros 2 bytes base = 0
   210 00000289 00                        db 0x00       ; 3er byte base = 0
   211 0000028A 92                        db 10010010b  ; atributos: P=1 DPL=00 S=1 TIṔO=001 (E=0 por lo tanto es segmento de datos, ED=0, W=1 por lo tanto puedo escribir) A=0 
   212 0000028B 00                        db 0x00       ; parte alta atributos = 0
   213 0000028C 00                        db 0x00       ; 4to byte base = 0
   214                                  
   215                                  ; descriptor de datos de nivel 3 (Base: 0, size 100h, nivel 0)
   216                                  dataSel_Niv3 equ $-gdt ; selector del descriptor de segmento de datos de nivel 3 --> index = 1, TI = 0, RPL = 11 (Niv 3)
   217 0000028D FF00                      dw 0x00ff     ; limite parte baja = 255 = 0xff --> limite + 1 = 256 = 0x100 = 100h
   218 0000028F [C50D]                    dw datos_anillo3 ; otra forma de definir la base, con una etiqueta
   219 00000291 00                        db 0x00       ; 3er byte base = 0
   220 00000292 F2                        db 11110010b  ; atributos: P=1 DPL=11 S=1 TIṔO=001 (E=0 por lo tanto es segmento de datos, ED=0, W=1 por lo tanto puedo escribir) A=0 
