   744 000005D8 A820                      test al, 0x20       ; ¿Está vacío el THR? (bit 5)
   745 000005DA 74F8                      jz wait2            ; Si no está vacío, esperar
   746 000005DC 3EA0[7100]                mov al, [ds:contadorUnidadT1]
   747 000005E0 0430                      add al, 0x30        ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   748 000005E2 BAF803                    mov dx, 0x3f8
   749 000005E5 EE                        out dx, al
   750                                    wait3:
