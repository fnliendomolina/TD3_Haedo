   237 000002A1 00                        db 0x00       ; 3er byte base = 0
   238 000002A2 9A                        db 10011010b  ; atributos: P=1 DPL=00 S=1 TIPO=101 (E=1 por lo tanto es segmento de codigo, C=0, R=1 por lo tanto puedo leer y ejecutar) A=0
   239 000002A3 00                        db 0x00       ; parte alta atributos = 0
   240 000002A4 00                        db 0x00       ; 4to byte base = 0
