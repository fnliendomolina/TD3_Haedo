   531 00000438 B8[7D02]                    mov ax, gdt         ; cargo base de la gdt en ax
   532 0000043B 66A3[0500]                  mov [gdtr + 2], eax	; a partir del 3 byte, que es donde esta el campo base de la GDTR, son 4 bytes, por eso uso eax
   533                                  
   534                                      ;cargo idtr
   535 0000043F B80F01                      mov ax, idtSize - 1	;longitud de idt - 1
   536 00000442 A3[0900]                    mov [idtr + 0], ax		
