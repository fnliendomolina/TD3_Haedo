   731                                  puertoSerieHandler:
   732                                    wait1:
   733 000005C2 BAFD03                    mov dx, 0x3FD  
   734 000005C5 EC                        in al, dx           ; Leo Line Status Register, para ver si el buffer del puerto serie esta libre
   735 000005C6 A820                      test al, 0x20       ; ¿Está vacío el THR? (bit 5)
   736 000005C8 74F8                      jz wait1            ; Si no está vacío, esperar
   737 000005CA 3EA0[7200]                mov al, [ds:contadorDecenaT1]
   738 000005CE 0430                      add al, 0x30        ;al sumarle 0x30 = 48 a un numero en decimal, obtengo su valor en ascii
   739 000005D0 BAF803                    mov dx, 0x3f8
   740 000005D3 EE                        out dx, al
   741                                    wait2:
   742 000005D4 BAFD03                    mov dx, 0x3FD  
