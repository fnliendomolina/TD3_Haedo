  1236                                  irq1Handler: ;Entra cada vez que se pulsa una tecla
  1237 000009C6 FA                          cli ;deshabilito interrupciones
  1238                                      ;bajo flag de interrupcion --   EOI End of Interrupt. mandatorio.
  1239 000009C7 B020                        mov al, 0x20   ; 0x20, comando para bajar flag de interrupcion
  1240 000009C9 E620                        out 0x20, al   ; 0x20 aca es la direccion del puerto de E/S del PIC Master
  1241                                      
  1242                                      ; aca leo el teclado para ver si se presiono la j, que es la que hara algo que haga saltar una excepcion
  1243 000009CB E460                        in al, 0x60               ; IMPORTANTE! aunque no lo use, leer el scan code porque sino se llena el buffer del teclado!!
  1244 000009CD 3C24                        cmp al, KEY_J_MakeCode  ; Si se pulso la tecla J no salta 
  1245 000009CF 7512                        jne no_j         ; Si no se pulso la j, al sera distinto a 0x24 por lo tanto salta a no_es_la_jota y sigue
  1246                                  
  1247                                      ;si se pulso la jota no salta, hago algo que genere una excepcion, como por ejemplo dividir por 0
  1248                                      ;Cuando divido por un registro de 32 bits (EXC), el par de registros EAX:EDX (número de 64 bits) se divide por este registro (EXC). Por lo tanto, debo poner a  cero el registro EAX y colocar el dividendo en EDX
  1249 000009D1 6631C0                      xor eax, eax ; pongo en 0 eax
  1250 000009D4 66BA01000000                mov edx, 1   ; pongo el dividendo (cualquiera) en edx, en este caso 1
  1251 000009DA 66B900000000                mov ecx, 0   ; pongo el divisor 0, en edx
  1252 000009E0 66F7F1                      div ecx      ; hace eax:edx dividido exc, osea algo dividido 0, debe generar la excepcion de dividir por 0
  1253                                  
  1254                                      no_j:
  1255 000009E3 6631DB                        xor ebx, ebx ; limpio registro ebx
  1256                                        ;si keyPressState es 1 es porque ya pulse, por lo tanto cuando vuelva a entrar aca es porque solte y no aumento contador
  1257 000009E6 3E8A1E[0F00]                  mov bl, [ds:keyPressState]
  1258 000009EB 80FB00                        cmp bl, 0
  1259 000009EE 756A                          jne reset_keyPressState ;si keyPressState es 0, por lo tanto sigue
  1260                                                                ;si keyPressState es 1, es porque ya solte, por lo tanto salta y resetea estado tecla
  1261                                                               
  1262                                        ;pone en 1 keyPressState y analiza si se presiona W, E o Q
  1263 000009F0 B301                          mov bl, 1
  1264 000009F2 881E[0F00]                    mov [keyPressState], bl
  1265 000009F6 3C11                          cmp al, KEY_W_MakeCode  ; Si se pulso la tecla W 
  1266 000009F8 7424                          je pressW       
  1267 000009FA 3C12                          cmp al, KEY_E_MakeCode  ; Si se pulso la tecla E
  1268 000009FC 743E                          je pressE  
  1269 000009FE 3C10                          cmp al, KEY_Q_MakeCode ; Si se pulso la tecla Q
  1270 00000A00 755F                          jne fin_handler   
  1271                                  
  1272                                        ;Logica si pulse Q --> Pinto pantalla de blanco y hago HLT
  1273                                        ;Primero pinto toda la pantalla de blanco (video inverso):
  1274 00000A02 B9D007                        mov cx, 80*25     ;cargo cantidad de puntos en pantalla a pintar
  1275 00000A05 66BF00000000                  mov edi, 0x00     ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
  1276                                      bucle_pantalla2: ; pinta toda la pantalla de blanco
  1277 00000A0B B000                          mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
  1278 00000A0D 26678807                      mov [es:edi], al ;borro caracter 
  1279 00000A11 6647                          inc edi          ;incremento edi para pasar al atributo
  1280 00000A13 B060                          mov al, COLOR_BG     ;cargo valor del atributo para poner cada caracter en blanco y fondo en blanco --> 0 111 | 0 111
  1281 00000A15 26678807                      mov [es:edi], al 
  1282 00000A19 6647                          inc edi          ;incremento edi para pasar al otro caracter
  1283                                        ;ciclo hasta terminar de recorrer el buffer de video
  1284 00000A1B E2EE                        loop bucle_pantalla2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
  1285                                      
  1286 00000A1D F4                          hlt 
  1287                                  
  1288                                      pressW: ;logica si pulse W --> aumento 10% prioridad de tarea A y disminuyo 10% prioridad de tarea B
  1289                                        ;si ticksMaxTask2 = 0 no sigo decrementandolo
  1290 00000A1E 3EA0[1500]                    mov al,[ds:ticksMaxTask2]
  1291 00000A22 3C00                          cmp al,0
  1292 00000A24 743B                          je fin_handler
  1293                                        ;si ticksMaxTask2 todavia no es 0, aumento en 1 ticksMaxTarea1 y disminuyo en 1 ticksMaxTarea2
  1294 00000A26 3EA0[1400]                    mov al,[ds:ticksMaxTask1]
  1295 00000A2A FEC0                          inc al
  1296 00000A2C 3EA2[1400]                    mov [ds:ticksMaxTask1],al
  1297 00000A30 3EA0[1500]                    mov al,[ds:ticksMaxTask2]
  1298 00000A34 FEC8                          dec al
  1299 00000A36 3EA2[1500]                    mov [ds:ticksMaxTask2],al
  1300 00000A3A EB25                          jmp fin_handler
  1301                                  
  1302                                      pressE: ;logica si pulse E --> aumento 10% prioridad de tarea B y disminuyo 10% prioridad de tarea A
  1303                                        ;si ticksMaxTask1 = 0 no sigo decrementandolo
  1304 00000A3C 3EA0[1400]                    mov al,[ds:ticksMaxTask1]
  1305 00000A40 3C00                          cmp al,0
  1306 00000A42 741D                          je fin_handler
  1307                                        ;si ticksMaxTask1 todavia no es 0, aumento en 1 ticksMaxTask2 y disminuyo en 1 ticksMaxTask1
  1308 00000A44 3EA0[1500]                    mov al,[ds:ticksMaxTask2]
  1309 00000A48 FEC0                          inc al
  1310 00000A4A 3EA2[1500]                    mov [ds:ticksMaxTask2],al
  1311 00000A4E 3EA0[1400]                    mov al,[ds:ticksMaxTask1]
  1312 00000A52 FEC8                          dec al
  1313 00000A54 3EA2[1400]                    mov [ds:ticksMaxTask1],al    
  1314 00000A58 EB07                          jmp fin_handler
  1315                                  
  1316                                      reset_keyPressState:     ;reset keyPressState
