  1396                                  excHandler: ; handler general de la excepcion --> aca pinto toda la pantalla de azul por ejemplo, muestro un mensaje de error y numero de excepcion
  1397 00000AAB FA                          cli
  1398                                  
  1399 00000AAC 6658                        pop eax         ; saco número excepción (vector) de la pila
  1400 00000AAE 88C3                        mov bl, al      ; guardo en bl
  1401                                      
  1402                                      ; Primero pinto toda la pantalla de azul: usare el selector de video, pero recordar que ya lo habia cargado de antes en es
  1403 00000AB0 B9D007                      mov cx, 80*25 ;cargo cantidad de puntos en pantalla a pintar
  1404 00000AB3 66BF00000000                mov edi, 0x00 ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
  1405 00000AB9 66BA00000000                mov edx, 0x00
  1406                                      
  1407                                      bucle_pantalla_2: ; pinta toda la pantalla de azul
  1408 00000ABF B000                          mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
  1409 00000AC1 26678807                      mov [es:edi], al ;borro caracter 
  1410 00000AC5 6647                          inc edi          ;incremento edi para pasar al atributo
  1411 00000AC7 B011                          mov al, COLOR_BG_EXCEPTION     ;cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
  1412 00000AC9 26678807                      mov [es:edi], al 
  1413 00000ACD 6647                          inc edi          ;incremento edi para pasar al otro caracter
  1414                                        ;ciclo hasta terminar de recorrer el buffer de video
  1415 00000ACF E2EE                        loop bucle_pantalla_2 ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
  1416                                      
  1417 00000AD1 6631FF                      xor edi, edi ; vuelvo a poner el offset en 0, para escribir en el primer caracter
  1418 00000AD4 6631C0                      xor eax, eax ; vuelvo a poner en 0 eax
  1419                                      
  1420                                      ;Ahora muestro mensaje de "error"
  1421                                      printLoop:
  1422 00000AD7 3E678A82[1E000000]            mov al, BYTE [ds:msgException+edx] ; Lee un caracter del string
  1423 00000ADF 3C00                          cmp al, 0                    ; Si es 0 (Null) termina (End Of String)
  1424 00000AE1 7412                          je finMensaje
  1425 00000AE3 6642                          inc edx                      ; Incremento puntero string
  1426 00000AE5 26678807                      mov [es:edi], al             ; Imprimo el caracter que esta almacenado en al
  1427 00000AE9 6647                          inc edi                      ; Incremento el puntero (Color (atributo) del caracter)
  1428 00000AEB B017                          mov al, 0x17                 ; Cargo valor del atributo para poner cada caracter en azul y fondo en azul --> 0x11 = 0 001 | 0 001 (R=0, G=0, B=1)
  1429 00000AED 26678807                      mov [es:edi], al
  1430 00000AF1 6647                          inc edi                      ; Incremento el puntero (Siguiente caracter)
  1431 00000AF3 EBE2                          jmp printLoop; vuelvo a el inicio de la etiqueta loop
  1432                                      finMensaje: ;Imprimo numero de excepcion
  1433 00000AF5 80C330                        add bl, '0'     ; convierto a ASCII
  1434 00000AF8 2667881F                      mov [es:edi], bl
  1435 00000AFC 6647                          inc edi
  1436 00000AFE B017                          mov al, 0x17
  1437 00000B00 26678807                      mov [es:edi], al
  1438 00000B04 6647                          inc edi
  1439 00000B06 EBFE                          jmp $
  1440 00000B08 FB                            sti
