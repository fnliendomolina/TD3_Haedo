   649 000004EC 3DE803                    cmp ax,TIME_EXEC_SERIAL_PORT ;Si paso 1s = 1000ms --> Conmuto a serialPortHandler
   650 000004EF 7514                      jne continue
   651 000004F1 3EC706[1200]0000          mov WORD[ds:timeSerialPort], 0 ; Reseteo timeSerialPort
   652                                    ;bajo busy flag de la tarea de nivel 0 (a llamar)
   653 000004F8 B089                      mov al, 0x89  ;   1000 1001
   654 000004FA A2[EF02]                  mov [gdt + tssTaskSerialPort_Lvl0_Sel + 5], al
   655 000004FD FB                        sti
   656 000004FE EA00006000                jmp tssTaskSerialPort_Lvl0_Sel:0
   657 00000503 EBC7                      jmp irq0Handler
   658                                  
   659                                    continue:
   660                                    ;si ticksMaxTask1 = 0 --> solo ejecuto T2
   661 00000505 3EA0[1400]                mov al,[ds:ticksMaxTask1]
   662 00000509 3C00                      cmp al,0
   663 0000050B 742E                      je execOnlyTask2
   664                                    ;si ticksMaxTask2 = 0 --> solo ejecuto T1
