   507                                  ;-------- Remapeo de las interrupciones de los PICs -----------------------------------------------------------
   508                                    ;Inicializacion PIC 1
   509 00000413 B011                      mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   510 00000415 E620                      out 0x20, al
   511 00000417 B020                      mov al, 0x20 ; icw2: INT base para el PIC N#1 tipo 20H (osea ahora IRQ0 sera el tipo de interrupcion 20h)
   512 00000419 E621                      out 0x21, al ; el PIC1 comienza en 0x20
   513 0000041B B004                      mov al, 0x04 ; icw3: PIC N#1 Master tiene un slave conectado a IRQ2 (0000 0100b)
   514 0000041D E621                      out 0x21, al
   515 0000041F B001                      mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   516 00000421 E621                      out 0x21, al
   517                                  
   518                                    ;Inicializacion PIC 2
   519 00000423 B011                      mov al, 0x11 ; icw1: IRQs activas por flanco, modo cascada
   520 00000425 E6A0                      out 0xa0, al
   521 00000427 B028                      mov al, 0x28 ; icw2: INT base para el PIC N#1 tipo 28h
   522 00000429 E6A1                      out 0xa1, al ; el PIC2 comienza en 0x28
   523 0000042B B002                      mov al, 0x02 ; icw3: PIC N#2 Slave, IRQ2 es la linea que envia al Master (010b)
   524 0000042D E6A1                      out 0xa1, al
   525 0000042F B001                      mov al, 0x01 ; icw4: Modo No Buffered, Fin de interrupcion normal, procesador 8086
   526 00000431 E6A1                      out 0xa1, al
   527                                  
   528                                  ;-------- Reconfiguro Timer para que interrumpa cada 1ms ------------
   529                                    ; Para reprogramar el timer tick para que interrumpa cada 1 ms
   530                                    ; debo dividir los 1,193180Mhz por la cuenta a cargar en el 8253/4
   531                                    ; Por ejemplo: 1mseg1.19e6 / 04a6h (1190) = 1000 ints/s 
   532 00000433 B8A604                    mov ax,04a6h
   533 00000436 E640                      out 40h,al ; Parte Baja
   534 00000438 88E0                      mov al,ah
   535 0000043A E640                      out 40h,al ; Parte Alta
   536                                  
   537                                  ;-------- Habilito binario en el RTC (bit 2 del registro B) --------
   538                                    ; Paso 1: Selecciono el registro B
   539 0000043C B00B                      mov al, 0x0B
   540 0000043E E670                      out 70h, al
   541 00000440 E471                      in al, 71h          ; Leo el valor actual del registro B
   542 00000442 88C3                      mov bl, al          ; Lo guardo en BL
   543                                    ; Paso 2: Seteo el bit 2 (DM = 1) para binario
   544 00000444 80CB04                    or bl, 00000100b    ; BL = BL | 0x04
   545                                    ; Paso 3: Vuelvo a escribir el registro B con el bit 2 activado
   546 00000447 B00B                      mov al, 0x0B
   547 00000449 E670                      out 70h, al
   548 0000044B 88D8                      mov al, bl
   549 0000044D E671                      out 71h, al
   550                                  
