   635                                    ;Me fijo si alguna de las tareas llego a su tiempo maximo (180s) y cuelgo el programa con HLT
   636 000004D1 3EA0[1A00]                mov al,[ds:timeMaxTask1]
   637 000004D5 3CB4                      cmp al,MAX_TIME_EXEC_TASK ; 180s son 3 minutos, el maximo que pide la consigna
   638 000004D7 7501                      jne continueProgram
   639 000004D9 F4                        hlt 
   640                                    continueProgram:
   641 000004DA 3EA0[1C00]                mov al,[ds:timeMaxTask2]
   642 000004DE 3CB4                      cmp al,MAX_TIME_EXEC_TASK ; 180s son 3 minutos, el maximo que pide la consigna
