   552                                  
   553                                    ;cargo gdtr
   554 0000044F B87700                    mov ax, gdtSize - 1	;cargo limite a la gdtr: longitud de gdt - 1
   555 00000452 A3[0300]                  mov [gdtr + 0], ax	;a partir de la primer posicion de los 6 bytes de gdtr, osea ocupo 2 bytes, que es el tamaño del limite, por eso uso ax
   556                                  
   557 00000455 6631C0                    xor eax, eax
   558 00000458 B8[8A02]                  mov ax, gdt         ; cargo base de la gdt en ax
   559 0000045B 66A3[0500]                mov [gdtr + 2], eax	; a partir del 3 byte, que es donde esta el campo base de la GDTR, son 4 bytes, por eso uso eax
   560                                  
   561                                    ;cargo idtr
   562 0000045F B80F01                    mov ax, idtSize - 1	;longitud de idt - 1
   563 00000462 A3[0900]                  mov [idtr + 0], ax		
   564                                  
   565 00000465 6631C0                    xor eax, eax
   566 00000468 66B8[02030000]            mov eax, idt
   567 0000046E 66A3[0B00]                mov [idtr + 2], eax	;ubicacion de la idt en memoria	
   568                                  
   569                                    ;cargo en el registro gdtr
   570 00000472 0F0116[0300]              lgdt [gdtr]
   571                                  
   572                                    ;cargo en el registro idtr      load idt
   573 00000477 0F011E[0900]              lidt [idtr]
   574                                  
   575                                    ;paso a modo protegido
   576 0000047C 0F20C0                    mov eax, cr0
   577 0000047F 0C01                      or al,1
   578 00000481 0F22C0                    mov cr0, eax
   579 00000484 EB00                      jmp short $+2
   580                                  
   581                                    ;cargo ss, ds, y es con el selector del descriptor de datos de nivel 0 (es lo usare para escribir en pantalla)
   582 00000486 B80800                    mov ax, dataSel_Lvl0
   583 00000489 8ED0                      mov ss, ax
   584 0000048B 8ED8                      mov ds, ax
   585 0000048D B81800                    mov ax, videoSel_Lvl0
   586 00000490 8EC0                      mov es, ax
