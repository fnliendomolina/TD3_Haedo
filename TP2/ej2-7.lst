   628                                  irq0Handler: ; Este es el handler del Scheduler, se conmuta a el con cada interrupcion del timertick mediante una puerta de tarea 
   629                                    ;deshabilito interrupciones
   630 000004CC FA                        cli
   631                                    ;bajo flag de interrupcion
   632 000004CD B020                      mov al, 0x20
   633 000004CF E620                      out 0x20, al
