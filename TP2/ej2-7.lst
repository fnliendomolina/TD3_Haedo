   589 00000492 EA[9704]2000              jmp codeSel_Lvl0:modo_protegido
   590                                  
   591                                  modo_protegido:
   592                                    ;apunto esp al final del codigo + 0x100
   593 00000497 66B8[090B0000]            mov eax, stackTaskInit_Lvl0            ; Pila de la tarea inicial
   594 0000049D 6689C4                    mov esp, eax
   595                                  
   596                                    ;enmascaro todas las interrupciones menos la irq1 (Teclado)int 21h y irq0 (timer tick) disable int 20h (Luego del remapeado quedo asi)                                           
   597 000004A0 B0FC                      mov al, 0xfc   ; Mascara PIC Master   0xfc   1111 1100 --> osea la IRQ1 es el 2do bit, la IRQ0 el primer bit, poniendo en 0 la habilito
   598 000004A2 E621                      out 0x21, al   ; 0x21 es la direccion del registro de enmascaramiento del PIC Master
   599 000004A4 B0FF                      mov al, 0xff   ; Mascara PIC Slave, ponemos todo en 1, osea deshabilito todas sus interrupciones pues no las uso
   600 000004A6 E6A1                      out 0xa1, al   ; 0xA1 es la direccion del registro de enmascaramiento del PIC Slave
   601                                  
   602                                    ;cargo tss inicial --> lo cargo en tr
   603 000004A8 B85000                    mov ax, tssTaskInit_Lvl0_Sel
   604 000004AB 0F00D8                    ltr ax
   605                                  
   606                                    ;Primero pinto toda la pantalla de blanco (video inverso):
   607 000004AE B9D007                    mov cx, 80*25     ;cargo cantidad de puntos en pantalla a pintar
   608 000004B1 66BF00000000              mov edi, 0x00     ;cargo edi en 0 porque ahora tambien borrare los caracteres, por lo tanto me movere por todos los bytes de la pantalla
   609                                    bucle_pantalla: ; pinta toda la pantalla de blanco
   610 000004B7 B000                      mov al, 0x00     ;poniendo el byte de caracter todo en 0 borra el caracter
   611 000004B9 26678807                  mov [es:edi], al ;borro caracter 
   612 000004BD 6647                      inc edi          ;incremento edi para pasar al atributo
   613 000004BF B060                      mov al, COLOR_BG     ;cargo valor del atributo para poner cada caracter en blanco y fondo en blanco --> 0 111 | 0 111
   614 000004C1 26678807                  mov [es:edi], al 
   615 000004C5 6647                      inc edi          ;incremento edi para pasar al otro caracter
   616                                    ;ciclo hasta terminar de recorrer el buffer de video
   617 000004C7 E2EE                      loop bucle_pantalla ; loop usa al registro cx: decrementa cx. Si cx vale mas que 0, salta a la etiqueta indicada
   618                                  
